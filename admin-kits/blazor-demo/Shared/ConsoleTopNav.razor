@implements IDisposable
@inject NavigationManager Nav

<nav class="topnav" aria-label="Sections">
    <div class="topnav__inner">
        <NavLink class="topnav__link" href="" Match="NavLinkMatch.All"><Icon Name="dashboard" /><span>Dashboard</span></NavLink>
        <NavLink class="topnav__link" href="analytics"><Icon Name="chart" /><span>Analytics</span></NavLink>
        <details class="topnav__item @(InGroup("transactions", "datagrid", "terminals") ? "is-current" : "")" data-dismiss>
            <summary class="topnav__trigger"><Icon Name="layers" Class="icon--sm" /><span>Operations</span><Icon Name="chevron-down" Class="icon--sm topnav__chevron" /></summary>
            <div class="card topnav__menu">
                <NavLink class="navlink" href="transactions"><Icon Name="transactions" /><span>Transactions</span></NavLink>
                <NavLink class="navlink" href="datagrid"><Icon Name="grid" /><span>Data grid</span></NavLink>
                <NavLink class="navlink" href="terminals"><Icon Name="terminal" /><span>Terminals</span></NavLink>
            </div>
        </details>
        <details class="topnav__item @(InGroup("settings") ? "is-current" : "")" data-dismiss>
            <summary class="topnav__trigger"><Icon Name="settings" Class="icon--sm" /><span>Configuration</span><Icon Name="chevron-down" Class="icon--sm topnav__chevron" /></summary>
            <div class="card topnav__menu">
                <NavLink class="navlink" href="settings"><Icon Name="settings" /><span>Settings</span></NavLink>
            </div>
        </details>
    </div>
</nav>

@code {
    bool InGroup(params string[] routes)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        return routes.Contains(path);
    }

    protected override void OnInitialized() => Nav.LocationChanged += Changed;
    void Changed(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Nav.LocationChanged -= Changed;
}
