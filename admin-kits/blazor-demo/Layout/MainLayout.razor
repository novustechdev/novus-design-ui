@inherits LayoutComponentBase

<div class="adminwrap">
    <div class="demobar">Built with the Novus Design Kit · <a href="https://ui-kit.novustech.dev/admin-kit.html">back to the docs</a></div>
    <header class="appbar">
        <div class="appbar__inner appheader">
            <div class="appheader__left">
                <span class="theme-novapay vlogo">
                    <svg class="vmark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12" rx="2"/><line x1="3.5" y1="9.5" x2="20.5" y2="9.5"/><rect x="6" y="12" width="3.6" height="3" rx="0.6"/></svg>
                    <span class="wm"><span class="nm">nova</span><span class="sf">pay</span></span>
                </span>
                <span class="muted appsuffix">operations · admin</span>
            </div>
            <div class="appheader__right">
                <a class="btn btn--ghost btn--sm toggle44" href="login">Sign out</a>
                <button class="btn btn--ghost btn--sm toggle44 themetoggle" data-theme-toggle aria-label="Toggle light and dark theme">
        <svg class="ic-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7Z"/></svg>
        <svg class="ic-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="3.2"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M13 3l-1.4 1.4M4.4 11.6 3 13"/></svg>
      </button>
                <span class="appheader__sep"></span>
                <span class="appheader__endorse"><span class="brandmark" role="img" aria-label="Novus Technologies"></span></span>
            </div>
        </div>
    </header>
    <div class="adminbody">
        <details class="adminnav" open>
            <summary>Menu</summary>
            <nav aria-label="Admin">
                <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink href="analytics">Analytics</NavLink>
                <NavLink href="transactions">Transactions</NavLink>
                <NavLink href="datagrid">Data grid</NavLink>
                <NavLink href="terminals">Terminals</NavLink>
                <NavLink href="settings">Settings</NavLink>
            </nav>
        </details>
        <main>
            @Body
        </main>
    </div>
</div>
