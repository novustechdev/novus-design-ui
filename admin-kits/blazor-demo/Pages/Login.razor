@page "/login"
@layout AuthLayout
@inject NavigationManager Nav

<PageTitle>Sign in · Novus Admin Kit</PageTitle>

@* WebAssembly twin of the Blazor Server sign-in: same markup, client-side check. *@
<div class="authsplit">
    <AuthBrand />
    <main class="authmain">
        <form class="card authcard" @onsubmit="Submit" @onsubmit:preventDefault>
            <svg class="authcard__mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12" rx="2"/><line x1="3.5" y1="9.5" x2="20.5" y2="9.5"/><rect x="6" y="12" width="3.6" height="3" rx="0.6"/></svg>
            <h1 class="authcard__title">Sign in to your console</h1>
            <p class="muted authcard__sub">Sample console: sign in with admin / admin. Nothing is stored.</p>
            <div class="field@(Error ? " field--error" : "")" id="userfield">
                <label for="l-user">Username<span class="field__req" aria-hidden="true">*</span></label>
                <input class="input" id="l-user" @bind="User" autocomplete="username" required aria-describedby="loginerror">
                <p class="field__error" id="loginerror" role="alert" hidden="@(!Error)">Wrong username or password. Use admin / admin.</p>
            </div>
            <div class="field">
                <label for="l-pass">Password<span class="field__req" aria-hidden="true">*</span></label>
                <div class="pwgroup">
                    <input class="input" id="l-pass" type="password" @bind="Pass" autocomplete="current-password" required>
                    <PasswordToggle />
                </div>
            </div>
            <button class="btn btn--primary btn--lg authcard__submit">Sign in</button>
            <AuthSso />
            <details class="authcard__forgot"><summary>Forgot password?</summary><p class="muted">In this sample, password resets are handled by your administrator.</p></details>
            <div class="authcard__foot"><span class="muted">Managed by</span><span class="brandmark" role="img" aria-label="Novus Technologies"></span></div>
        </form>
    </main>
</div>

@code {
    string User = "", Pass = "";
    bool Error;

    void Submit()
    {
        if (User == "admin" && Pass == "admin") Nav.NavigateTo(Nav.BaseUri);
        else Error = true;
    }
}
