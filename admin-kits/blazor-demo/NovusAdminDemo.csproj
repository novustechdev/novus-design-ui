<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyNovusKit" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <NovusKit Include="node_modules/novus-design-kit/**/*" />
      <D3 Include="node_modules/d3/dist/d3.min.js" />
    </ItemGroup>
    <Copy SourceFiles="@(NovusKit)" DestinationFiles="@(NovusKit->'wwwroot/lib/novus-design-kit/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(D3)" DestinationFiles="@(D3->'wwwroot/lib/d3/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
